{
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"]
  },
  "imports": {
    "three": "npm:three@0.180.0",
    "three/addons/": "npm:/three@0.180.0/examples/jsm/",
    "@types/three": "npm:@types/three@0.180.0",
    "@types/three/": "npm:/@types/three@0.180.0/",
    "playwright": "npm:playwright@1.56.1"
  },
  "exclude": ["legacy/", "dist/", "artifacts/"],
  "lint": {
    "rules": { "exclude": ["no-explicit-any"] }
  },
  "fmt": { "lineWidth": 110 },
  "tasks": {
    "build": "deno run -A tools/build.ts",
    "dev": "deno task build && deno run --allow-net=127.0.0.1:8800 --allow-read=dist tools/serve.ts",
    "check": "deno check main.ts src/ tools/ tests/",
    "test": "deno test --allow-read --allow-write=artifacts tests/",
    "lint": "deno lint",
    "scenarios": "deno run --allow-read --allow-write=artifacts tools/scenarios.ts",
    "sim": "deno run --allow-read --allow-write=artifacts tools/sim.ts",
    "balance": "deno run --allow-read --allow-write=artifacts tools/balance.ts",
    "lists": "deno run --allow-read --allow-write=docs,artifacts --allow-run tools/gen-lists.ts",
    "capture": "deno run -A tools/capture.ts",
    "batch": "deno run --allow-read --allow-write=artifacts tools/batch.ts",
    "pareto": "deno run --allow-read --allow-write=src/data,artifacts tools/pareto.ts"
  }
}
